NGINX_PROXY_IMAGE=nginxproxy/nginx-proxy:1.11.0
ACME_COMPANION_IMAGE=nginxproxy/acme-companion:2.6.3
WG_EASY_IMAGE=ghcr.io/wg-easy/wg-easy:15

WG_UI_DOMAIN=vpn.example.com
WG_HOST=vpn.example.com
WG_PORT=51820
WG_DNS=1.1.1.1,8.8.8.8
WG_IPV4_CIDR=10.8.0.0/24
WG_IPV6_CIDR=fdcc:ad94:bacf:61a3::/64
WG_ALLOWED_IPS=0.0.0.0/0
WG_DISABLE_IPV6=true

# Used only for the first wg-easy startup. menu.sh removes WG_ADMIN_PASSWORD
# from .env after the first successful start.
WG_INIT_ENABLED=false
WG_ADMIN_USERNAME=admin
WG_ADMIN_PASSWORD=

LETSENCRYPT_EMAIL=admin@example.com

# Optional Beszel monitoring profile. Fill these and run:
# docker compose --profile monitoring up -d
BESZEL_IMAGE=henrygd/beszel:v0.18.7
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:v0.18.7
BESZEL_DOMAIN=monitoring.example.com
BESZEL_AGENT_LISTEN=/beszel_socket/beszel.sock
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=
